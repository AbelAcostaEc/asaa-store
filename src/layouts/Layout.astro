---
import { ClientRouter } from "astro:transitions";
import FloatingWhatsApp from "../components/FloatingWhatsApp.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import SEO from "../components/SEO.astro";
import "../styles/global.css";

interface Props {
	title: string;
	description?: string;
	image?: string;
	canonical?: string;
	structuredData?: object;
}

const { title, description = "Asaa Store, tambien conocido como Bazar Angie: tienda online en Ecuador con tecnologia, accesorios, utiles escolares y productos kawaii.", image, canonical, structuredData } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/img/favicon.png" />
		<meta name="generator" content={Astro.generator} />

		<!-- SEO Component -->
		<SEO title={title} description={description} image={image} canonical={canonical} structuredData={structuredData} />

		<!-- Additional Meta Tags -->
		<meta name="keywords" content="asaa store, asaa soluciones, bazar angie, bazar kawaii angie, tienda online ecuador, tecnologia, gadgets, utiles escolares, productos kawaii, accesorios, papeleria" />
		<meta name="author" content="Asaa Soluciones" />
		<meta name="robots" content="index, follow" />

		<ClientRouter />
	</head>
	<body>
		<Header />
		<slot />
		<Footer />
		<FloatingWhatsApp />
	</body>
</html>
