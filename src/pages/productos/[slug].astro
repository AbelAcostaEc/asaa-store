---
import Layout from "../../layouts/Layout.astro";
import { allProducts, formatPrice } from "../../lib/products";

export function getStaticPaths() {
	return allProducts.map((product) => ({
		params: { slug: product.slug },
		props: { product },
	}));
}

const { product } = Astro.props;
const phoneNumber = "593998894898";
const categoryLabel = product.category === "tech" ? "Tecnología" : "Bazar Kawaii";
const backUrl = product.category === "tech" ? "/tech" : "/kawaii";
const priceLabel = formatPrice(product.price);
const message = `¡Hola! Estoy interesad@ en comprar el producto: ${product.name}. Precio visto: ${priceLabel}.`;
const whatsappURL = `https://wa.me/${phoneNumber}?text=${encodeURIComponent(message)}`;
const mainImage = product.imagesList[0] ?? "/img/preview.png";

const structuredData = {
	"@context": "https://schema.org",
	"@type": "Product",
	name: product.name,
	description: product.description,
	image: product.imagesList.map((image) => `https://asaa-soluciones.netlify.app${image}`),
	category: categoryLabel,
	offers: {
		"@type": "Offer",
		availability: "https://schema.org/InStock",
		priceCurrency: "USD",
		...(product.price ? { price: product.price } : {}),
	},
};
---

<Layout title={`${product.name} | Asaa Soluciones`} description={product.description} image={mainImage} canonical={`/productos/${product.slug}`} structuredData={structuredData}>
	<main class="bg-gray-50">
		<section class="container mx-auto px-4 py-8 sm:py-12">
			<a href={backUrl} class="mb-6 inline-flex items-center gap-2 text-sm font-bold text-gray-600 transition-colors hover:text-gray-900">
				<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"></path>
				</svg>
				Volver a {categoryLabel}
			</a>

			<div class="grid gap-8 lg:grid-cols-[minmax(0,1.08fr)_minmax(320px,0.92fr)] lg:items-start">
				<div class="space-y-3">
					<div class="aspect-square overflow-hidden rounded-lg border border-gray-200 bg-white">
						<img id="product-main-image" src={mainImage} alt={product.name} class="h-full w-full object-contain" width="900" height="900" loading="eager" decoding="async" fetchpriority="high" />
					</div>

					{
						product.imagesList.length > 1 && (
							<div class="grid grid-cols-4 gap-3 sm:grid-cols-5">
								{product.imagesList.map((image, index) => (
									<button type="button" class="product-thumb aspect-square overflow-hidden rounded-lg border-2 border-gray-200 bg-white p-1 transition hover:border-gray-500" data-image={image} aria-label={`Ver imagen ${index + 1} de ${product.name}`}>
										<img src={image} alt={`${product.name} ${index + 1}`} class="h-full w-full object-contain" width="180" height="180" loading="lazy" decoding="async" />
									</button>
								))}
							</div>
						)
					}
				</div>

				<aside class="rounded-lg border border-gray-200 bg-white p-5 shadow-sm sm:p-6">
					<p class={`mb-2 text-sm font-bold uppercase tracking-wide ${product.category === "tech" ? "text-tech" : "text-kawaii"}`}>{categoryLabel}</p>
					<h1 class="mb-3 text-3xl font-extrabold text-gray-900 sm:text-4xl">{product.name}</h1>
					<p class="mb-5 text-base leading-relaxed text-gray-600">{product.description}</p>

					<div class="mb-6 flex items-end justify-between gap-4 border-y border-gray-100 py-4">
						<div>
							<p class="text-xs font-bold tracking-wide text-gray-500 uppercase">Precio</p>
							<p class="text-3xl font-extrabold text-gray-900">{priceLabel}</p>
						</div>
						{product.oldPrice && <p class="text-sm font-semibold text-gray-400 line-through">{formatPrice(product.oldPrice)}</p>}
					</div>

					<a href={whatsappURL} target="_blank" rel="noopener noreferrer" class={`flex w-full items-center justify-center gap-2 rounded-full px-5 py-4 text-base font-bold text-white shadow-lg transition hover:scale-[1.02] ${product.category === "tech" ? "gradient-tech" : "gradient-kawaii"}`}>
						<svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
							<path
								d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
							></path>
						</svg>
						Comprar por WhatsApp
					</a>
				</aside>
			</div>
		</section>
	</main>
</Layout>

<script>
	let productGalleryCleanup: (() => void) | undefined;

	function initProductGallery() {
		productGalleryCleanup?.();

		const mainImage = document.getElementById("product-main-image") as HTMLImageElement | null;
		const thumbs = document.querySelectorAll<HTMLButtonElement>(".product-thumb");
		const cleanups: Array<() => void> = [];

		if (!mainImage || thumbs.length === 0) {
			productGalleryCleanup = undefined;
			return;
		}

		thumbs.forEach((button) => {
			const handleClick = () => {
				const image = button.dataset.image;
				if (!image) return;

				mainImage.src = image;
				thumbs.forEach((thumb) => thumb.classList.remove("border-gray-700"));
				button.classList.add("border-gray-700");
			};

			button.addEventListener("click", handleClick);
			cleanups.push(() => button.removeEventListener("click", handleClick));
		});

		thumbs[0]?.classList.add("border-gray-700");
		productGalleryCleanup = () => cleanups.forEach((cleanup) => cleanup());
	}

	initProductGallery();
	document.addEventListener("astro:page-load", initProductGallery);
	document.addEventListener("astro:before-swap", () => productGalleryCleanup?.());
</script>
