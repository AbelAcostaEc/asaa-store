---
import Gallery from "../components/Gallery.astro";
import Layout from "../layouts/Layout.astro";

const structuredData = {
	"@context": "https://schema.org",
	"@type": "CollectionPage",
	name: "Bazar & Variedades Kawaii",
	description: "Productos kawaii adorables: mochilas, peluches, accesorios y artículos únicos que alegrarán tu día",
	url: "https://asaa-soluciones.netlify.app/kawaii",
};
---

<Layout title="Kawaii - Bazar y Variedades Adorables | Asaa Soluciones" description="Explora nuestra colección kawaii: mochilas adorables, peluches, accesorios y artículos únicos. Compra por WhatsApp con envío a Ecuador." canonical="/kawaii" structuredData={structuredData}>
	<div class="sticky top-0 z-10 flex w-full justify-end p-3">
		<a href="/tech" class="border-tech text-tech flex items-center gap-2 rounded-full border bg-white px-4 py-2">
			<svg class="text-tech h-5 w-5">
				<use href="/sprite.svg#device"></use>
			</svg>
			Ver Tecnología
		</a>
	</div>
	<h2 class="text-center text-2xl font-bold">Bazar & Variedades Kawaii</h2>
	<p class="text-md mb-5 text-center">Explora nuestra encantadora colección de productos kawaii, desde adorables accesorios hasta artículos únicos que alegrarán tu día.</p>
	<Gallery category="kawaii" />
</Layout>
