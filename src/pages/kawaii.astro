---
import Gallery from "../components/Gallery.astro";
import Layout from "../layouts/Layout.astro";

const structuredData = {
	"@context": "https://schema.org",
	"@type": "CollectionPage",
	name: "Bazar & Variedades Kawaii",
	description: "Productos kawaii adorables: mochilas, peluches, accesorios y artículos únicos que alegrarán tu día",
