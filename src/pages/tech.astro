---
import Gallery from "../components/Gallery.astro";
import Layout from "../layouts/Layout.astro";

const structuredData = {
	"@context": "https://schema.org",
	"@type": "CollectionPage",
	name: "Productos de Tecnología",
	description: "Los mejores gadgets tecnológicos: mouse, teclados, soportes, audífonos y más accesorios tech al mejor precio",
	url: "https://asaa-soluciones.netlify.app/tech",
};
---

<Layout title="Tecnología - Gadgets y Accesorios Tech | Asaa Soluciones" description="Descubre los mejores gadgets tecnológicos: mouse gaming, teclados, soportes para laptop, audífonos y más. Compra por WhatsApp con envío a Ecuador." canonical="/tech" structuredData={structuredData}>
	<div class="sticky top-0 z-10 flex w-full justify-end p-3">
		<a href="/kawaii" class="border-kawaii text-kawaii flex items-center gap-2 rounded-full border bg-white px-4 py-2">
			<svg class="text-kawaii h-5 w-5">
				<use href="/sprite.svg#star"></use>
			</svg>
			Ver Kawaii
		</a>
	</div>
	<h2 class="text-center text-2xl font-bold">Productos de Tecnología</h2>
	<p class="text-md mb-5 text-center">Los mejores gadgets al mejor precio</p>
	<Gallery category="tech" />
</Layout>
