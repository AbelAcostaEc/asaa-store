---
import { allProducts, formatPrice } from "../lib/products";

// Select products marked with heroSection: true
const featuredProducts = allProducts.filter((product) => product.heroSection === true);

const phoneNumber = "593998894898";
---

<div id="hero-slider" class="relative h-[500px] w-full overflow-hidden bg-gradient-to-br from-purple-600 via-pink-500 to-orange-400">
	<div class="slider-container relative h-full w-full">
		{
			featuredProducts.map((product, index) => {
				const imagePath = product.imagesList[0] ?? "/img/preview.png";
				const category = product.category;
				const priceLabel = formatPrice(product.price);
				const detailUrl = `/productos/${product.slug}`;
				const message = `¡Hola! Estoy interesad@ en el producto destacado: ${product.name}. Precio visto: ${priceLabel}.`;
				const whatsappURL = `https://wa.me/${phoneNumber}?text=${encodeURIComponent(message)}`;

				return (
					<div class={`slide absolute inset-0 flex items-center justify-center transition-opacity duration-700 ${index === 0 ? "opacity-100" : "opacity-0"}`} data-slide={index}>
						<div class="container mx-auto px-4">
							<div class="flex flex-col items-center gap-8 md:flex-row md:justify-center">
								{/* Image */}
								<div class="animate-float w-full md:w-1/2 lg:w-1/3">
									<div class="overflow-hidden rounded-2xl bg-white p-4 shadow-2xl">
										<a href={detailUrl} aria-label={`Ver ${product.name}`}>
											<img src={imagePath} alt={product.name} class="h-64 w-full rounded-lg object-contain md:h-80" width="520" height="520" loading={index === 0 ? "eager" : "lazy"} decoding="async" />
										</a>
									</div>
								</div>

								{/* Content */}
								<div class="w-full text-center md:w-1/2 md:text-left lg:w-1/3">
									<span class={`mb-4 inline-block rounded-full px-4 py-1 text-sm font-semibold ${category === "tech" ? "bg-purple-500" : "bg-pink-500"} text-white shadow-lg`}>{category === "tech" ? "Tecnologia" : "Bazar Kawaii"}</span>
									<h2 class="mb-3 text-4xl font-extrabold text-white drop-shadow-[0_4px_12px_rgba(0,0,0,0.5)] md:text-5xl lg:text-6xl">{product.name}</h2>
									<p class="mb-3 text-lg text-white/90 drop-shadow-md md:text-xl">{product.description}</p>
									<p class="mb-6 text-3xl font-extrabold text-white drop-shadow-md">{priceLabel}</p>
									<div class="flex flex-col gap-3 sm:flex-row md:justify-start">
										<a href={detailUrl} class="inline-flex items-center justify-center rounded-full bg-white px-7 py-3 text-base font-extrabold text-gray-900 shadow-xl transition-all duration-300 hover:scale-105">
											Ver producto
										</a>
										<a href={whatsappURL} target="_blank" rel="noopener noreferrer" class="glass-effect inline-flex items-center justify-center gap-2 rounded-full px-7 py-3 text-base font-bold text-white shadow-xl transition-all duration-300 hover:scale-105">
											<svg class="h-5 w-5">
												<use href="/sprite.svg#whatsapp" />
											</svg>
											Comprar
										</a>
									</div>
								</div>
							</div>
						</div>
					</div>
				);
			})
		}
	</div>

	{/* Navigation Dots */}
	<div class="absolute bottom-5 left-1/2 flex -translate-x-1/2 gap-3">
		{featuredProducts.map((_, index) => <button class={`dot h-3 w-3 rounded-full transition-all duration-300 ${index === 0 ? "w-8 bg-white" : "bg-white/50 hover:bg-white/80"}`} data-slide-to={index} aria-label={`Go to slide ${index + 1}`} />)}
	</div>
</div>

<script>
	let heroSliderCleanup: (() => void) | undefined;

	function initSlider() {
		heroSliderCleanup?.();

		const slider = document.getElementById("hero-slider");
		if (!slider) return;

		const slides = slider.querySelectorAll(".slide");
		const dots = slider.querySelectorAll(".dot");
		const container = slider.querySelector(".slider-container");
		if (slides.length === 0) return;

		let currentSlide = 0;
		let autoplayInterval: number | undefined;
		let isPaused = false;

		function showSlide(index: number) {
			if (slides.length === 0) return;
			const safeIndex = ((index % slides.length) + slides.length) % slides.length;

			// Hide all slides
			slides.forEach((slide) => {
				slide.classList.remove("opacity-100");
				slide.classList.add("opacity-0");
			});

			// Update dots
			dots.forEach((dot, i) => {
				if (i === safeIndex) {
					dot.classList.add("w-8", "bg-white");
					dot.classList.remove("bg-white/50");
				} else {
					dot.classList.remove("w-8", "bg-white");
					dot.classList.add("bg-white/50");
				}
			});

			// Show current slide
			slides[safeIndex].classList.remove("opacity-0");
			slides[safeIndex].classList.add("opacity-100");
			currentSlide = safeIndex;
		}

		function nextSlide() {
			if (!isPaused) {
				const next = (currentSlide + 1) % slides.length;
				showSlide(next);
			}
		}

		function startAutoplay() {
			if (slides.length < 2) return;
			autoplayInterval = window.setInterval(nextSlide, 5000);
		}

		function stopAutoplay() {
			if (autoplayInterval) {
				clearInterval(autoplayInterval);
				autoplayInterval = undefined;
			}
		}

		const dotCleanups: Array<() => void> = [];

		// Dot navigation
		dots.forEach((dot, index) => {
			const handleDotClick = () => {
				showSlide(index);
				stopAutoplay();
				startAutoplay(); // Restart autoplay
			};

			dot.addEventListener("click", handleDotClick);
			dotCleanups.push(() => dot.removeEventListener("click", handleDotClick));
		});

		// Pause on hover
		if (container) {
			const pauseSlider = () => {
				isPaused = true;
			};

			const resumeSlider = () => {
				isPaused = false;
			};

			container.addEventListener("mouseenter", pauseSlider);
			container.addEventListener("mouseleave", resumeSlider);

			heroSliderCleanup = () => {
				stopAutoplay();
				dotCleanups.forEach((cleanup) => cleanup());
				container.removeEventListener("mouseenter", pauseSlider);
				container.removeEventListener("mouseleave", resumeSlider);
			};
		} else {
			heroSliderCleanup = () => {
				stopAutoplay();
				dotCleanups.forEach((cleanup) => cleanup());
			};
		}

		// Start autoplay
		startAutoplay();
	}

	// Initialize on load
	initSlider();

	// Re-initialize after Astro navigation
	document.addEventListener("astro:page-load", initSlider);
	document.addEventListener("astro:before-swap", () => heroSliderCleanup?.());
</script>
