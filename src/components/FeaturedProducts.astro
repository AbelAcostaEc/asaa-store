---
import ProductCard from "./ProductCard.astro";
import { allProducts } from "../lib/products";

const featuredProducts = allProducts.filter((product) => product.heroSection).slice(0, 4);
---

{
	featuredProducts.length > 0 && (
		<section class="bg-white py-12 sm:py-16">
			<div class="container mx-auto px-4">
				<div class="mb-8 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
					<div>
						<p class="text-sm font-bold tracking-wide text-pink-600 uppercase">Lo mas buscado</p>
						<h2 class="text-3xl font-extrabold text-gray-900 sm:text-4xl">Productos destacados</h2>
					</div>
					<div class="flex gap-3">
						<a href="/kawaii" class="rounded-full border border-pink-200 px-5 py-2 text-sm font-bold text-pink-700 transition hover:bg-pink-50">
							Kawaii
						</a>
						<a href="/tech" class="rounded-full border border-purple-200 px-5 py-2 text-sm font-bold text-purple-700 transition hover:bg-purple-50">
							Tecnologia
						</a>
					</div>
				</div>

				<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 sm:gap-6 lg:grid-cols-4">
					{featuredProducts.map((product) => (
						<ProductCard product={product} category={product.category} />
					))}
				</div>
			</div>
		</section>
	)
}
